<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless Avalonia renders the desktop client's scenes to artifacts/visual/avalonia/<scene>__<theme>.png for the
       visual-regression compare (scripts/visual/compare.mjs; plan avalonia-client §23). Not AOT: test code only. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- astra-desktop is a self-contained WinExe; referencing it from a test host is intended. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Astra.Desktop\Astra.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The fixture set both sides replay (tests/fixtures/ui/README.md). Copied so tests read it from the output folder. -->
    <None Include="..\fixtures\ui\**\*" Link="Fixtures\ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
