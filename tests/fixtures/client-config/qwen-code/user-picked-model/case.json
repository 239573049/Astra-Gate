{
  "client": "qwen-code",
  "env": {},
  "gatewayBaseUrl": "https://astra.corp.com",
  "localKey": "sk-astra-enterprise-key",
  "model": "gpt-5",
  "extras": {
    "models": {
      "gpt-5": {
        "id": "gpt-5",
        "name": "GPT-5",
        "contextWindow": 400000,
        "maxOutputTokens": 128000,
        "vision": true,
        "reasoning": true,
        "protocols": [
          "openai-responses"
        ]
      }
    }
  },
  "steps": [
    {
      "op": "enable"
    },
    {
      "op": "disable",
      "edit": [
        {
          "file": ".qwen/settings.json",
          "write": "{\n  \"env\": { \"ASTRA_QWEN_API_KEY\": \"sk-astra-enterprise-key\" },\n  \"security\": { \"auth\": { \"selectedType\": \"anthropic\" } },\n  \"model\": { \"name\": \"user-choice\" }\n}\n"
        }
      ]
    }
  ]
}
