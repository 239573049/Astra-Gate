[
  {
    "file": "$HOME/.claude/settings.json",
    "format": "json",
    "keyPath": "env.ANTHROPIC_BASE_URL",
    "kind": "key",
    "before": null,
    "after": "\"https://astra.corp.com\""
  },
  {
    "file": "$HOME/.claude/settings.json",
    "format": "json",
    "keyPath": "env.ANTHROPIC_AUTH_TOKEN",
    "kind": "key",
    "before": null,
    "after": "\"sk-astra-enterprise-key\""
  },
  {
    "file": "$HOME/.claude/settings.json",
    "format": "json",
    "keyPath": "env.ANTHROPIC_MODEL",
    "kind": "key",
    "before": null,
    "after": "\"claude-sonnet-4-5[1m]\""
  },
  {
    "file": "$HOME/.claude/settings.json",
    "format": "json",
    "keyPath": "env.ANTHROPIC_DEFAULT_HAIKU_MODEL",
    "kind": "key",
    "before": null,
    "after": "\"claude-haiku-4-5\""
  },
  {
    "file": "$HOME/.claude/settings.json",
    "format": "json",
    "keyPath": "env.MAX_THINKING_TOKENS",
    "kind": "key",
    "before": null,
    "after": "\"8000\""
  },
  {
    "file": "$HOME/.claude/settings.json",
    "format": "json",
    "keyPath": "env.DISABLE_PROMPT_CACHING",
    "kind": "key",
    "before": null,
    "after": "\"1\""
  }
]
