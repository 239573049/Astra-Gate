{
  "client": "vscode-copilot",
  "env": {},
  "gatewayBaseUrl": "https://astra.corp.com",
  "localKey": "sk-astra-enterprise-key",
  "model": "gpt-5",
  "extras": {
    "models": {
      "gpt-5": {
        "id": "gpt-5",
        "name": "GPT-5",
        "contextWindow": 400000,
        "maxOutputTokens": 128000,
        "vision": true,
        "reasoning": true,
        "protocols": [
          "openai-responses"
        ]
      }
    }
  },
  "steps": [
    {
      "op": "enable"
    },
    {
      "op": "disable",
      "edit": [
        {
          "file": "Library/Application Support/Code/User/chatLanguageModels.json",
          "write": "[\n  { \"vendor\": \"customendpoint\", \"name\": \"Astra\", \"apiType\": \"responses\", \"models\": [ { \"id\": \"hand-edited\" } ] }\n]\n"
        }
      ]
    },
    {
      "op": "force-restore"
    }
  ]
}
