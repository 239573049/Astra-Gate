{
  "client": "vscode-copilot",
  "env": {},
  "gatewayBaseUrl": "https://astra.corp.com",
  "localKey": "sk-astra-enterprise-key",
  "model": "gpt-5",
  "extras": {
    "models": {
      "gpt-5": {
        "id": "gpt-5",
        "name": "GPT-5",
        "contextWindow": 400000,
        "maxOutputTokens": 128000,
        "vision": true,
        "reasoning": true,
        "protocols": [
          "openai-responses"
        ]
      }
    }
  },
  "steps": [
    {
      "op": "enable"
    },
    {
      "op": "enable",
      "context": {
        "localKey": "sk-astra-second-key",
        "model": "deepseek-chat",
        "extras": {
          "models": {
            "c": {
              "id": "deepseek-chat",
              "name": "DeepSeek Chat",
              "contextWindow": 64000,
              "maxOutputTokens": 8000,
              "vision": false,
              "protocols": [
                "openai-chat"
              ]
            }
          }
        }
      }
    },
    {
      "op": "disable"
    }
  ]
}
