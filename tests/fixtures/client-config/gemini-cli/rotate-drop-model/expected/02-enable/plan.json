[
  {
    "file": "$HOME/.gemini/.env",
    "format": "env",
    "keyPath": "GOOGLE_GEMINI_BASE_URL",
    "kind": "key",
    "before": "https://astra.corp.com",
    "after": "\"https://astra.corp.com\""
  },
  {
    "file": "$HOME/.gemini/.env",
    "format": "env",
    "keyPath": "GEMINI_API_KEY",
    "kind": "key",
    "before": "sk-astra-enterprise-key",
    "after": "\"sk-astra-enterprise-key\""
  },
  {
    "file": "$HOME/.gemini/.env",
    "format": "env",
    "keyPath": "GEMINI_MODEL",
    "kind": "key",
    "before": "gemini-2.5-pro",
    "after": "\"gemini-2.5-pro\""
  },
  {
    "file": "$HOME/.gemini/settings.json",
    "format": "json",
    "keyPath": "security.auth.selectedType",
    "kind": "key",
    "before": "\"gemini-api-key\"",
    "after": "\"gemini-api-key\""
  }
]
