[
  {
    "file": "$HOME/.gemini/.env",
    "format": "env",
    "keyPath": "GOOGLE_GEMINI_BASE_URL",
    "kind": "key",
    "before": null,
    "after": "\"https://astra.corp.com\""
  },
  {
    "file": "$HOME/.gemini/.env",
    "format": "env",
    "keyPath": "GEMINI_API_KEY",
    "kind": "key",
    "before": "AIzaSyOriginal0123456789abcdef",
    "after": "\"sk-astra-enterprise-key\""
  },
  {
    "file": "$HOME/.gemini/settings.json",
    "format": "json",
    "keyPath": "security.auth.selectedType",
    "kind": "key",
    "before": "\"oauth-personal\"",
    "after": "\"gemini-api-key\""
  }
]
