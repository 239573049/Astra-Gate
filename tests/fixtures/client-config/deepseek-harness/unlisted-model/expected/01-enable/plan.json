[
  {
    "file": "$HOME/.dsh/.env",
    "format": "env",
    "keyPath": "ASTRA_GATEWAY_API_KEY",
    "kind": "key",
    "before": null,
    "after": "\"sk-astra-enterprise-key\""
  },
  {
    "file": "$HOME/.dsh/profiles/desktop/cordis.patch.yml",
    "format": "yaml",
    "keyPath": "[id=llm-pi-ai].config.providers.astra",
    "kind": "key",
    "before": null,
    "after": "{\"displayName\":\"Astra\",\"apiKeyEnv\":\"ASTRA_GATEWAY_API_KEY\",\"api\":\"openai-completions\",\"baseURL\":\"https://astra.corp.com/v1\",\"models\":[{\"id\":\"deepseek-chat\",\"name\":\"DeepSeek Chat\",\"contextWindow\":128000,\"maxTokens\":8192},{\"id\":\"brand-new\",\"name\":\"brand-new\"}]}"
  },
  {
    "file": "$HOME/.dsh/profiles/desktop/cordis.patch.yml",
    "format": "yaml",
    "keyPath": "[id=agent-default-model].config.provider",
    "kind": "key",
    "before": "\"mine\"",
    "after": "\"astra\""
  },
  {
    "file": "$HOME/.dsh/profiles/desktop/cordis.patch.yml",
    "format": "yaml",
    "keyPath": "[id=agent-default-model].config.model",
    "kind": "key",
    "before": "\"m1\"",
    "after": "\"brand-new\""
  },
  {
    "file": "$HOME/.dsh/profiles/desktop/cordis.patch.yml",
    "format": "yaml",
    "keyPath": "[id=agent-default-model].config.reasoningEffort",
    "kind": "key",
    "before": "\"high\"",
    "after": null
  }
]
