{
  "client": "deepseek-harness",
  "env": {},
  "gatewayBaseUrl": "https://astra.corp.com",
  "localKey": "sk-astra-enterprise-key",
  "model": "gpt-5",
  "extras": {
    "models": {
      "deepseek-chat": {
        "id": "deepseek-chat",
        "name": "DeepSeek Chat",
        "contextWindow": 128000,
        "maxOutputTokens": 8192,
        "protocols": [
          "openai-chat"
        ]
      },
      "gpt-5": {
        "id": "gpt-5",
        "name": "GPT-5",
        "contextWindow": 400000,
        "maxOutputTokens": 128000,
        "vision": true,
        "protocols": [
          "openai-responses",
          "openai-chat"
        ]
      },
      "claude-sonnet-4-5": {
        "id": "claude-sonnet-4-5",
        "name": "Claude Sonnet 4.5",
        "contextWindow": 200000,
        "maxOutputTokens": 300000,
        "vision": true,
        "protocols": [
          "anthropic"
        ]
      },
      "gemini-2.5-pro": {
        "id": "gemini-2.5-pro",
        "name": "Gemini 2.5 Pro",
        "vision": false,
        "protocols": [
          "gemini"
        ]
      },
      "plain-model": {
        "id": "plain-model"
      }
    }
  },
  "steps": [
    {
      "op": "enable"
    },
    {
      "op": "disable"
    }
  ]
}
