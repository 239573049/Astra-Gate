{
  "client": "deepseek-harness",
  "env": {},
  "gatewayBaseUrl": "https://astra.corp.com",
  "localKey": "sk-astra-enterprise-key",
  "model": "deepseek-chat",
  "extras": {
    "models": {
      "deepseek-chat": {
        "id": "deepseek-chat",
        "name": "DeepSeek Chat",
        "contextWindow": 128000,
        "maxOutputTokens": 8192,
        "protocols": [
          "openai-chat"
        ]
      }
    }
  },
  "steps": [
    {
      "op": "enable"
    },
    {
      "op": "disable",
      "edit": [
        {
          "file": ".dsh/profiles/desktop/cordis.patch.yml",
          "delete": true
        }
      ]
    }
  ]
}
