{
  // my opencode setup
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": { "llama3": { "name": "Llama 3" } }
    }
  },
  "model": "ollama/llama3",
  "autoupdate": true, // keep

}
