[
  {
    "file": "$HOME/.hermes/config.yaml",
    "format": "yaml",
    "keyPath": "model.provider",
    "kind": "key",
    "before": "\"custom\"",
    "after": "\"custom\""
  },
  {
    "file": "$HOME/.hermes/config.yaml",
    "format": "yaml",
    "keyPath": "model.base_url",
    "kind": "key",
    "before": "\"https://astra.corp.com/v1\"",
    "after": "\"https://astra.corp.com/v1\""
  },
  {
    "file": "$HOME/.hermes/config.yaml",
    "format": "yaml",
    "keyPath": "model.api_key",
    "kind": "key",
    "before": "\"sk-astra-enterprise-key\"",
    "after": "\"sk-astra-second-key\""
  },
  {
    "file": "$HOME/.hermes/config.yaml",
    "format": "yaml",
    "keyPath": "model.default",
    "kind": "key",
    "before": "\"kimi-k2.5\"",
    "after": "\"claude-sonnet-4-5\""
  },
  {
    "file": "$HOME/.hermes/config.yaml",
    "format": "yaml",
    "keyPath": "model.api_mode",
    "kind": "key",
    "before": "\"chat_completions\"",
    "after": "\"anthropic_messages\""
  }
]
