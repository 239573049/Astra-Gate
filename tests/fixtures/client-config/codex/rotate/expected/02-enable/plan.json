[
  {
    "file": "$HOME/.codex/config.toml",
    "format": "toml",
    "keyPath": "model_provider",
    "kind": "key",
    "before": "\"astra\"",
    "after": "\"\\u0022astra\\u0022\""
  },
  {
    "file": "$HOME/.codex/config.toml",
    "format": "toml",
    "keyPath": "model",
    "kind": "key",
    "before": "\"gpt-5\"",
    "after": "\"\\u0022deepseek-chat\\u0022\""
  },
  {
    "file": "$HOME/.codex/config.toml",
    "format": "toml",
    "keyPath": "model_providers.astra.base_url",
    "kind": "key",
    "before": "\"https://astra.corp.com/v1\"",
    "after": "\"\\u0022https://astra2.corp.com/v1\\u0022\""
  },
  {
    "file": "$HOME/.codex/config.toml",
    "format": "toml",
    "keyPath": "model_providers.astra.experimental_bearer_token",
    "kind": "key",
    "before": "\"sk-astra-enterprise-key\"",
    "after": "\"\\u0022sk-astra-rotated-key\\u0022\""
  }
]
