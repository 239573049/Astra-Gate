[
  {
    "file": "$HOME/.gemini/antigravity/settings.json",
    "format": "json",
    "keyPath": "modelProvider",
    "kind": "key",
    "before": null,
    "after": "\"gemini\""
  },
  {
    "file": "$HOME/.gemini/antigravity/settings.json",
    "format": "json",
    "keyPath": "model",
    "kind": "key",
    "before": "\"gemini-3-pro\"",
    "after": "\"astra/gpt-5\""
  },
  {
    "file": "$HOME/.gemini/antigravity/settings.json",
    "format": "json",
    "keyPath": "customModelsConfig.customModels",
    "kind": "key",
    "before": "{\"mine/gem\":{\"apiProvider\":\"API_PROVIDER_GOOGLE_GEMINI\",\"modelName\":\"gem\"}}",
    "after": "{\"mine/gem\":{\"apiProvider\":\"API_PROVIDER_GOOGLE_GEMINI\",\"modelName\":\"gem\"},\"astra/gpt-5\":{\"apiProvider\":\"API_PROVIDER_GOOGLE_GEMINI\",\"modelName\":\"gpt-5\"},\"astra/claude-sonnet-4-5\":{\"apiProvider\":\"API_PROVIDER_GOOGLE_GEMINI\",\"modelName\":\"claude-sonnet-4-5\"},\"astra/deepseek-chat\":{\"apiProvider\":\"API_PROVIDER_GOOGLE_GEMINI\",\"modelName\":\"deepseek-chat\"}}"
  },
  {
    "file": "$HOME/.zshrc",
    "format": "shellblock",
    "keyPath": "antigravity",
    "kind": "key",
    "before": null,
    "after": "\"# Antigravity is routed through Astra. Turn the Antigravity client off in Astra to remove this block.\\nexport GOOGLE_GEMINI_BASE_URL=\\u0027https://astra.corp.com\\u0027\\nexport GEMINI_API_KEY=\\u0027sk-astra-enterprise-key\\u0027\""
  }
]
