{
  "client": "liveagent",
  "env": {
    "LIVEAGENT_HOME": "$HOME/la"
  },
  "gatewayBaseUrl": "https://astra.corp.com",
  "localKey": "sk-astra-enterprise-key",
  "model": "gpt-5",
  "extras": {
    "models": {
      "m1": {
        "id": "gpt-5",
        "name": "GPT-5",
        "contextWindow": 400000,
        "maxOutputTokens": 128000,
        "vision": true,
        "reasoning": true,
        "protocols": [
          "openai-responses",
          "openai-chat"
        ]
      },
      "m2": {
        "id": "claude-sonnet-4-5",
        "name": "Claude Sonnet 4.5",
        "contextWindow": 200000,
        "maxOutputTokens": 64000,
        "vision": true,
        "reasoning": true,
        "protocols": [
          "anthropic"
        ]
      },
      "m3": {
        "id": "deepseek-chat",
        "name": "DeepSeek Chat",
        "contextWindow": 64000,
        "maxOutputTokens": 8000,
        "vision": false,
        "reasoning": false
      }
    }
  },
  "steps": [
    {
      "op": "enable"
    },
    {
      "op": "disable"
    }
  ]
}
