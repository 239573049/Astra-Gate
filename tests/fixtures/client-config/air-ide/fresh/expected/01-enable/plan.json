    "kind": "key",
    "before": null,
    "after": "\"astra/gpt-5\""
  },
  {
    "file": "$HOME/.jetbrains/astra-opencode.json",
    "format": "json",
    "keyPath": "enabled_providers",
    "kind": "key",
    "before": null,
