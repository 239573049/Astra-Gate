    "after": "{\"npm\":\"@ai-sdk/openai-compatible\",\"name\":\"Astra\",\"options\":{\"baseURL\":\"https://astra.corp.com/v1\",\"apiKey\":\"sk-astra-enterprise-key\"},\"models\":{\"gpt-5\":{\"name\":\"GPT-5\",\"limit\":{\"context\":400000,\"output\":128000},\"modalities\":{\"input\":[\"text\",\"image\"],\"output\":[\"text\"]},\"reasoning\":true},\"claude-sonnet-4-5\":{\"name\":\"Claude Sonnet 4.5\",\"limit\":{\"context\":200000,\"output\":64000},\"modalities\":{\"input\":[\"text\",\"image\"],\"output\":[\"text\"]},\"reasoning\":true},\"deepseek-chat\":{\"name\":\"DeepSeek Chat\",\"limit\":{\"context\":64000,\"output\":8000},\"modalities\":{\"input\":[\"text\"],\"output\":[\"text\"]},\"reasoning\":false}}}"
  },
  {
