<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>astra-server</AssemblyName>
    <RootNamespace>Astra.Server</RootNamespace>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UserSecretsId>astra-server</UserSecretsId>
    <!-- AOT analyzer gate (IL2026/IL3050 are errors); does not flow through ProjectReference, so set per project. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The lambda Map* endpoints in Api/ are covered by the Request Delegate
         Generator, which the SDK auto-enables for AOT publishes. Turn it on
         for plain builds too so the analyzer gate sees the same call sites. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' != 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Astra.Core\Astra.Core.csproj" />
    <ProjectReference Include="..\Astra.Data\Astra.Data.csproj" />
    <ProjectReference Include="..\Astra.Providers\Astra.Providers.csproj" />
    <ProjectReference Include="..\Astra.Gateway\Astra.Gateway.csproj" />
    <ProjectReference Include="..\Astra.Clients\Astra.Clients.csproj" />
    <ProjectReference Include="..\Astra.Plugins\Astra.Plugins.csproj" />
  </ItemGroup>
  <!-- Jint's own CLR-interop and System.Text.Json paths (never used: no AllowClr, JSON-text interop only)
       trip ILC's trim/AOT analysis, and ILC can't collapse them for a package marked trimmable. This keeps
       them warnings for the ILC step alone — Roslyn's analyzer gate on our code is untouched — and
       scripts/check-aot-warnings.mjs fails the release on any IL warning not from Jint. plugin-selftest
       proves the published binary runs the plugin runtime. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <IlcArg Include="--nowarnaserr:IL2026" />
    <IlcArg Include="--nowarnaserr:IL2104" />
    <IlcArg Include="--nowarnaserr:IL3053" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Astra.Server.IntegrationTests" />
  </ItemGroup>
</Project>
