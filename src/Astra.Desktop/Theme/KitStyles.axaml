<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        x:Class="Astra.Desktop.Theme.KitStyles">
  <!-- App-wide corrections of Arc's themes toward the web (Theme/KitStyles.axaml.cs installs them into Application.Styles).
       Styles in Application.Styles apply after a control theme's own styles, so on the same property they win over Arc's triggers —
       which a code binding at Template priority (ArcTokens.Bind's default) cannot do. -->

  <!-- Primary buttons are the accent, not Arc's foreground fill: web components/ui/controls.tsx Button adds
       accent background and border, on-accent text to Arc's primary variant ("plan §9.1").
       The fill is the chosen accent itself in both themes (KitAccent: the web's accent variable is not lightened for dark like Arc's Accent token);
       the text is the web's onAccentColor (KitOnAccent, set by ThemeService), not Arc's AccentForeground, which is black on #007aff.
       Hover (opacity .91 + resting shadow), pressed (.84) and disabled (.52) stay Arc's, which are the web's numbers. -->
  <Style Selector="arc|Button[Variant=Primary]">
    <Setter Property="Background" Value="{DynamicResource KitAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KitAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource KitOnAccent}" />
  </Style>

  <!-- Segmented control: the selected pill is the web's control-selected colour (#fff light, white 16 % dark), not Arc's Surface (which is the
       translucent content material here). -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Avalonia's own menus (the tray icon's right-click menu is a MenuFlyoutPresenter in a window of its own, and Windows / Linux pop
           ContextMenus for the "more" button and the bridge's showContextMenu) have no control theme under Arc: they measured 0 x 0 and
           drew nothing. Arc's menus are its own controls (MenuSurface), which the tray menu cannot host, so these are the minimal
           themes in the web's menu colors. -->
      <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{DynamicResource KitMenuBackground}" BorderBrush="{DynamicResource KitMenuBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="4" MinWidth="180">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Continue" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{DynamicResource KitMenuBackground}" BorderBrush="{DynamicResource KitMenuBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="4" MinWidth="180">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Continue" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Background" Value="{DynamicResource KitMenuBorder}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource KitMenuText}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="PART_LayoutRoot" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <Panel>
                <Grid ColumnDefinitions="18,*,Auto,16">
                  <Path Name="PART_Check" IsVisible="False" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                        Data="M1,6 L4.5,9.5 L11,2.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" />
                  <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}" RecognizesAccessKey="True" VerticalAlignment="Center"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                  <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource KitMenuTextMuted}"
                             Text="{TemplateBinding InputGesture}" />
                  <Path Name="PART_Chevron" Grid.Column="3" Width="6" Height="10" Stretch="Uniform"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Data="M1,1 L5,5 L1,9" Stroke="{DynamicResource KitMenuTextMuted}"
                        StrokeThickness="1.4" />
                </Grid>
                <Popup Name="PART_Popup" Placement="RightEdgeAlignedTop" HorizontalOffset="-2" IsLightDismissEnabled="False"
                       IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}" OverlayInputPassThroughElement="{Binding $parent[Menu]}">
                  <Border Background="{DynamicResource KitMenuBackground}" BorderBrush="{DynamicResource KitMenuBorder}" BorderThickness="1"
                          CornerRadius="10" Padding="4" MinWidth="160">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Panel>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Path#PART_Check"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource KitMenuHover}" /></Style>
        <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource KitMenuHover}" /></Style>
        <Style Selector="^:empty /template/ Path#PART_Chevron"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
      </ControlTheme>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="KitControlSelected" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="KitMenuBackground" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="KitMenuBorder" Color="#31000000" />
          <SolidColorBrush x:Key="KitMenuText" Color="#E0000000" />
          <SolidColorBrush x:Key="KitMenuTextMuted" Color="#8C000000" />
          <SolidColorBrush x:Key="KitMenuHover" Color="#0F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="KitControlSelected" Color="#29FFFFFF" />
          <SolidColorBrush x:Key="KitMenuBackground" Color="#FF2A2A2D" />
          <SolidColorBrush x:Key="KitMenuBorder" Color="#32FFFFFF" />
          <SolidColorBrush x:Key="KitMenuText" Color="#E6FFFFFF" />
          <SolidColorBrush x:Key="KitMenuTextMuted" Color="#8FFFFFFF" />
          <SolidColorBrush x:Key="KitMenuHover" Color="#1AFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <!-- applied to the selection part by KitStyles.InstallSegmented (a template-set value a style cannot override) -->
</Styles>
