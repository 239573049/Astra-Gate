<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- AOT analyzer gate (IL2026/IL3050 are errors); does not flow through ProjectReference, so set per project. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runs magpie-compatible gateway middleware and agent plugins in process on Jaunt, a managed JS engine
         with no reflection interop: the host passes JSON text and JsValue only, and it is AOT-clean. -->
    <PackageReference Include="Jaunt" Version="1.0.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- magpie's plugin host, unmodified (Host/VENDORED.md); written out by HostAssets. -->
    <EmbeddedResource Include="Host\host.js" LogicalName="Astra.Plugins.Host.host.js" />
    <EmbeddedResource Include="Host\pi.js" LogicalName="Astra.Plugins.Host.pi.js" />
    <!-- a built-in copy of the community registry (astragate-community/astra-gate-plugins' registry.json), for when GitHub can't be reached -->
    <EmbeddedResource Include="Market\market.json" LogicalName="Astra.Plugins.Market.market.json" />
    <EmbeddedResource Include="V2\Runtime\boot.js" LogicalName="Astra.Plugins.V2.boot.js" />
    <EmbeddedResource Include="V2\Runtime\globals.js" LogicalName="Astra.Plugins.V2.globals.js" />
    <EmbeddedResource Include="V2\Runtime\astra.js" LogicalName="Astra.Plugins.V2.astra.js" />
    <EmbeddedResource Include="V2\Ui\components.json" LogicalName="Astra.Plugins.V2.components.json" />
    <EmbeddedResource Include="V2\Ui\scenes.json" LogicalName="Astra.Plugins.V2.scenes.json" />
    <EmbeddedResource Include="V2\Runtime\vitest.js" LogicalName="Astra.Plugins.V2.vitest.js" />
    <EmbeddedResource Include="V2\Runtime\testing.js" LogicalName="Astra.Plugins.V2.testing.js" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Astra.Core\Astra.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Astra.Plugins.Tests" />
  </ItemGroup>
</Project>
