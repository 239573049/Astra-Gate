    "Tree": { "props": { "nodes": "json", "source": "json", "expanded": "json", "selected": "json", "selection": "enum:none|single|multiple|checkbox", "nodeActions": "json", "reorderable": "boolean", "search": "boolean", "indent": "token:size", "dense": "boolean", "empty": "node", "onSelect": "action", "onExpand": "action", "onReorder": "action", "onNodePress": "action", "onNodeAction": "action", "onSearch": "action" }, "children": "none" },
