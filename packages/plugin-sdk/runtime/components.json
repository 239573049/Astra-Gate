  "common": {
    "visible": "json", "disabled": "json", "tooltip": "text", "testId": "string", "a11yLabel": "text", "fallback": "node",
    "width": "token:width", "grow": "number", "alignSelf": "token:align", "minWidth": "token:width", "maxWidth": "token:width",
    "span": "number", "priority": "enum:low|normal|high", "autoFocus": "boolean", "shortcut": "string"
  },
